# Compare ratings by type
rating_type = pd.crosstab(
    df["rating"],
    df["type"]
)

common = df["rating"].value_counts().head(8).index

print("\n--- RATINGS BY CONTENT TYPE ---")
print(
    rating_type.loc[
        rating_type.index.intersection(common)
    ]
)

rating_type.loc[
    rating_type.index.intersection(common)
].plot(
    kind="bar",
    figsize=(10, 5)
)

plt.title("Ratings: Movies vs TV Shows")
plt.xlabel("Rating")
plt.ylabel("Number of Titles")
plt.xticks(rotation=45)
plt.show()
